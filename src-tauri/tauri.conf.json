{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager",
  "version": "1.0.0",
  "identifier": "work.digitaldream.taskmanager",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../client && npm run build",
    "frontendDist": "../client/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Task Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "Tasks Widget",
        "url": "widget.html",
        "width": 350,
        "height": 500,
        "x": 50,
        "y": 50,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
