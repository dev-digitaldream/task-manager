# FlowSpace - Variables d'Environnement
# Copiez ce fichier en .env et remplissez les valeurs

# ===== ENVIRONNEMENT =====
NODE_ENV=development
# Options: development, production

# ===== SERVEUR =====
PORT=3001
# Port sur lequel le serveur écoute

CLIENT_URL=http://localhost:5173
# URL du client (pour CORS)

# ===== BASE DE DONNÉES =====
# SQLite (Développement uniquement)
DATABASE_URL=file:./dev.db

# PostgreSQL (Production recommandée)
# DATABASE_URL="postgresql://user:password@localhost:5432/flowspace?schema=public"

# ===== SMTP / EMAILS =====
# En développement (emails affichés dans la console)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# En production avec Resend (recommandé)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_VotreCleAPI_ICI
# SMTP_FROM=noreply@flowspaces.work

# ===== SÉCURITÉ =====
# Clé secrète pour JWT (générez-en une unique)
JWT_SECRET=votre_cle_secrete_tres_longue_et_aleatoire_ici

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===== STOCKAGE FICHIERS (Optionnel) =====
# Cloudflare R2 ou AWS S3
# STORAGE_TYPE=local
# Options: local, s3, r2

# Configuration S3/R2 (si STORAGE_TYPE=s3 ou r2)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_BUCKET=flowspace-avatars
# S3_ACCESS_KEY_ID=votre_access_key
# S3_SECRET_ACCESS_KEY=votre_secret_key
# S3_REGION=auto

# ===== MONITORING (Optionnel) =====
# Sentry pour le tracking d'erreurs
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===== PAIEMENTS (Futur) =====
# Stripe
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== AUTRES =====
# URL de base de l'application (pour les liens dans les emails)
APP_URL=http://localhost:5173

# Activer les logs détaillés
DEBUG=false