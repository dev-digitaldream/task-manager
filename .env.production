# ╔═══════════════════════════════════════════════════════════════════╗
# ║           FlowSpaces - Production Environment Variables            ║
# ║                                                                   ║
# ║ ⚠️  IMPORTANT: Ne jamais commiter ce fichier. Utiliser .env.local ║
# ║ 🔒 Tous les secrets doivent être stockés de façon sécurisée      ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ════════════════════════════════════════════════════════════════════
# 📍 APPLICATION
# ════════════════════════════════════════════════════════════════════

# Environment (production, staging, development)
NODE_ENV=production

# Port d'écoute du serveur
PORT=3001

# URL du frontend (pour CORS et liens)
CLIENT_URL=https://flowspaces.work

# ════════════════════════════════════════════════════════════════════
# 🗄️  DATABASE
# ════════════════════════════════════════════════════════════════════

# Option 1: SQLite (phase de test)
# DATABASE_URL=file:/app/data/dev.db

# Option 2: PostgreSQL (production)
DATABASE_URL=postgresql://user:password@localhost:5432/flowspaces_db

# ════════════════════════════════════════════════════════════════════
# 🔒 SECURITY & CORS
# ════════════════════════════════════════════════════════════════════

# Domaines autorisés pour CORS (séparés par virgule)
CORS_ORIGINS=https://flowspaces.work,https://www.flowspaces.work

# Rate limiting (production)
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes en ms
RATE_LIMIT_MAX_REQUESTS=100      # Requêtes max par fenêtre

# ════════════════════════════════════════════════════════════════════
# 📁 FILE STORAGE (Cloudinary)
# ════════════════════════════════════════════════════════════════════

# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API key
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API secret (à chiffrer en production)
CLOUDINARY_API_SECRET=your_api_secret

# ════════════════════════════════════════════════════════════════════
# 📧 EMAIL CONFIGURATION
# ════════════════════════════════════════════════════════════════════

# Provider: dev, postmark, sendgrid, smtp
EMAIL_PROVIDER=postmark

# Email from address
EMAIL_FROM=noreply@flowspaces.work

# ---- Postmark (recommandé) ----
POSTMARK_API_TOKEN=your_postmark_token

# ---- SendGrid (alternative) ----
SENDGRID_API_KEY=your_sendgrid_key

# ---- SMTP générique ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ════════════════════════════════════════════════════════════════════
# 🔑 JWT & SESSIONS
# ════════════════════════════════════════════════════════════════════

# JWT secret (générer avec: openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_here

# Session token expiry (en secondes)
SESSION_EXPIRY=2592000    # 30 jours

# ════════════════════════════════════════════════════════════════════
# 🔧 INTÉGRATIONS EXTERNES (Optionnel)
# ════════════════════════════════════════════════════════════════════

# ---- Zammad Ticketing ----
ZAMMAD_API_URL=https://zammad.example.com
ZAMMAD_API_KEY=your_zammad_key

# ---- osTicket ----
OSTICKET_API_URL=https://osticket.example.com
OSTICKET_API_KEY=your_osticket_key

# ---- Freshdesk ----
FRESHDESK_API_URL=https://yourdomain.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_key

# ════════════════════════════════════════════════════════════════════
# 🔍 MONITORING & LOGGING
# ════════════════════════════════════════════════════════════════════

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Sentry error tracking (optionnel)
SENTRY_DSN=

# ════════════════════════════════════════════════════════════════════
# 🧪 TESTING (Phase de test public)
# ════════════════════════════════════════════════════════════════════

# Autoriser les inscriptions publiques (true = oui, false = invitation uniquement)
ALLOW_PUBLIC_SIGNUP=true

# Créer des utilisateurs de démo (true = populate, false = DB vierge)
SEED_DEMO_DATA=false

# ════════════════════════════════════════════════════════════════════
# 📝 NOTES POUR VPS
# ════════════════════════════════════════════════════════════════════

# Avant de déployer:
# 1. Générer JWT_SECRET: openssl rand -base64 32
# 2. Remplacer TOUTES les valeurs "your_*" avec les vraies secrets
# 3. Utiliser un gestionnaire de secrets (Vault, AWS Secrets Manager, etc.)
# 4. Ne JAMAIS commiter ce fichier - utiliser .env.local ou secrets Docker
# 5. Restreindre permissions: chmod 600 .env
# 6. Ajouter à .gitignore: .env, .env.local, .env.*.local
